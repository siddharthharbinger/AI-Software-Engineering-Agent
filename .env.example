# ==============================================================================
# AI Software Engineering Agent Platform — Environment Configuration
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# LLM Providers (4-Way Failover Router)
# Priority order (comma-separated, lower index = tried first)
LLM_PROVIDER_PRIORITY=ollama,groq,openrouter,gemini

# Provider 1: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# Provider 2: Groq (Free tier, fast)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Provider 3: OpenRouter (Free router / fallback models)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Provider 4: Google Gemini (OpenAI-compat endpoint)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Circuit Breaker Defaults
CIRCUIT_DEFAULT_COOLDOWN_SECONDS=30
CIRCUIT_RATE_LIMIT_COOLDOWN_SECONDS=60

# Database & Vector Storage (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_platform

# Message Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Git Hosting Integrations
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

GITEA_URL=http://localhost:3000
GITEA_TOKEN=

# PM Tool Integration (Jira Cloud Free)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_POLL_INTERVAL_SECONDS=30

# Sandbox Security & Isolation
# Set to 'runsc' if gVisor runtime is installed in Docker daemon; defaults to 'runc' with hardened flags
SANDBOX_RUNTIME=runc
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_PIDS_LIMIT=100
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_FILES_TOUCHED=50

# Web UI
FRONTEND_PORT=5173
BACKEND_PORT=8000
